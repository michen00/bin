#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

# Detect platform
detect_platform() {
	case "$(uname -s)" in
	Darwin*)
		echo "macos"
		;;
	Linux*)
		if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
			echo "wayland"
		else
			echo "x11"
		fi
		;;
	CYGWIN* | MINGW* | MSYS*)
		echo "windows"
		;;
	*)
		echo "unknown"
		;;
	esac
}

# Select clipboard command based on platform
select_clipboard_command() {
	local platform=$1
	case "$platform" in
	macos)
		if command -v pbcopy >/dev/null 2>&1; then
			echo "pbcopy"
		else
			echo "ERROR:pbcopy not found"
		fi
		;;
	x11)
		if command -v xclip >/dev/null 2>&1; then
			echo "xclip -selection clipboard"
		elif command -v xsel >/dev/null 2>&1; then
			echo "xsel --clipboard"
		else
			echo "ERROR:xclip or xsel not found"
		fi
		;;
	wayland)
		if command -v wl-copy >/dev/null 2>&1; then
			echo "wl-copy"
		else
			echo "ERROR:wl-copy not found"
		fi
		;;
	windows)
		if command -v clip.exe >/dev/null 2>&1; then
			echo "clip.exe"
		else
			echo "ERROR:clip.exe not found"
		fi
		;;
	*)
		echo "ERROR:unsupported platform"
		;;
	esac
}

# Select dash character based on script name
select_dash() {
	case "$SCRIPT_NAME" in
	en_)
		echo "–" # en dash U+2013
		;;
	em_)
		echo "—" # em dash U+2014
		;;
	*)
		echo "ERROR:invalid script name"
		;;
	esac
}

# Display help message
usage() {
	local dash sibling
	case "$SCRIPT_NAME" in
	en_)
		dash="an en dash (–, U+2013)"
		sibling="em_ for an em dash"
		;;
	em_)
		dash="an em dash (—, U+2014)"
		sibling="en_ for an en dash"
		;;
	*)
		cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS]

Shared implementation of en_ and em_; run it through one of those names.
The name decides which dash is copied to the system clipboard:

  en_   en dash (–, U+2013)
  em_   em dash (—, U+2014)

Options:
  -h, --help    Show this help message and exit.
EOF
		return
		;;
	esac

	cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS]

Copies $dash to the system clipboard. Use $sibling.

Options:
  -h, --help    Show this help message and exit.

Examples:
  $SCRIPT_NAME
EOF
}

# Main execution
main() {
	# Parse command-line arguments
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		-*)
			echo "Error: Unknown option '$1'" >&2
			echo "Run '$SCRIPT_NAME --help' for usage information." >&2
			exit 2
			;;
		*)
			echo "Error: Unexpected argument '$1'; $SCRIPT_NAME accepts no arguments." >&2
			echo "Run '$SCRIPT_NAME --help' for usage information." >&2
			exit 2
			;;
		esac
	done

	# Validate script name
	if [[ "$SCRIPT_NAME" == "_mnn" ]]; then
		echo "Error: This script must be invoked as 'en_' or 'em_'" >&2
		exit 1
	fi

	# Select dash character
	local dash
	dash=$(select_dash)
	if [[ "$dash" == ERROR:* ]]; then
		echo "Error: This script must be invoked as 'en_' or 'em_'" >&2
		exit 1
	fi

	# Detect platform
	local platform
	platform=$(detect_platform)
	if [[ "$platform" == "unknown" ]]; then
		local uname_output
		uname_output=$(uname -s)
		echo "Error: Unsupported platform: $uname_output. This script supports macOS, Linux (X11/Wayland), and Windows." >&2
		exit 1
	fi

	# Select clipboard command
	local clipboard_cmd
	clipboard_cmd=$(select_clipboard_command "$platform")
	if [[ "$clipboard_cmd" == ERROR:* ]]; then
		case "$platform" in
		macos)
			echo "Error: Clipboard tool 'pbcopy' not found. macOS installs it in /usr/bin; add /usr/bin to PATH." >&2
			;;
		x11)
			echo "Error: Clipboard tool 'xclip' or 'xsel' not found. Please install xclip (preferred) or xsel." >&2
			;;
		wayland)
			echo "Error: Clipboard tool 'wl-copy' not found. Please install wl-clipboard package." >&2
			;;
		windows)
			echo "Error: Clipboard tool 'clip.exe' not found. Windows installs it in its System32 directory; add that directory to PATH." >&2
			;;
		esac
		exit 1
	fi

	# The command string can include arguments, as "xclip -selection clipboard"
	# does. Split it into an array so that the call below can quote its expansion.
	local -a clipboard_argv
	read -r -a clipboard_argv <<<"$clipboard_cmd"

	# Copy to clipboard
	printf "%s" "$dash" | "${clipboard_argv[@]}" || {
		echo "Error: Failed to copy to clipboard with '${clipboard_argv[0]}' (exit status $?)." >&2
		exit 1
	}
}

main "$@"
