#!/usr/bin/env bash

set -euo pipefail

SCRIPT_NAME=$(basename "$0")

usage() {
	cat <<EOF
Usage: $SCRIPT_NAME [OPTIONS] <commit> [<git-commit-option>...]

Creates a fixup commit for <commit>, then runs an interactive rebase with
autosquash and autostash enabled so that the fixup commit is squashed into
<commit>. Options are recognized only before <commit>; every argument after
<commit> is passed to 'git commit' unchanged.

Arguments:
  <commit>               The commit to fix up. It cannot be the root commit.
  <git-commit-option>    An argument to pass to 'git commit', such as -a.

Options:
  --                     End the options; the next argument is <commit>.
  -h, --help             Show this help message and exit.

Examples:
  $SCRIPT_NAME abc123     # Fix up abc123 with the staged changes
  $SCRIPT_NAME abc123 -a  # Fix up abc123 with all changes to tracked files

Notes:
  - This script requires Git and must be run inside a Git repository.
  - The rebase will stop for manual resolution if there are conflicts.
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		echo "Error: Unknown option '$1'" >&2
		usage >&2
		exit 2
		;;
	*)
		# Stop at the commit so that options meant for 'git commit', such as
		# -a, are not rejected as unknown options.
		break
		;;
	esac
done

if [[ $# -eq 0 ]]; then
	echo "Error: No commit specified." >&2
	usage >&2
	exit 2
fi

COMMIT="$1"
shift

if ! command -v git >/dev/null 2>&1; then
	echo "Error: 'git' is required but not installed." >&2
	echo "Install it from: https://git-scm.com/downloads" >&2
	exit 1
fi

# Validate the commit and resolve it to a hash. The fixup commit moves HEAD, so
# a name relative to HEAD, such as HEAD~1, would name a different commit by the
# time of the rebase, and the fixup commit would not be squashed.
if ! COMMIT_HASH=$(git rev-parse --verify "${COMMIT}^{commit}" 2>/dev/null); then
	# git exits 128 both outside a repository and for an unknown commit, so a
	# second call distinguishes the two. It runs only on this failure path, so
	# that a successful run does not start a second git process.
	if ! git rev-parse --git-dir >/dev/null 2>&1; then
		echo "Error: Not inside a git repository." >&2
		exit 1
	fi
	echo "Error: Invalid commit '$COMMIT'." >&2
	exit 1
fi

# Check if this is the root commit (has no parent)
if ! git rev-parse --verify "$COMMIT_HASH"~1 &>/dev/null; then
	echo "Error: Cannot fix up the root commit (it has no parent to rebase onto)." >&2
	echo "Workaround: git commit --fixup=$COMMIT && git rebase -i --autosquash --root" >&2
	exit 1
fi

if ! git commit --fixup="$COMMIT_HASH" "$@"; then
	echo "Error: Failed to create a fixup commit for '$COMMIT'." >&2
	exit 1
fi

git rebase -i --autosquash --autostash "$COMMIT_HASH"~1
