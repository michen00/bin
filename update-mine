#!/usr/bin/env bash

set -euo pipefail

# Initialize flags
DEBUG=false
ALL_BRANCHES=false

SCRIPT_NAME=$(basename "$0")

# Function to display usage information
usage() {
	cat <<EOF
Usage: $SCRIPT_NAME [--debug] [--all] <reference_branch>

By default, updates branches with open pull requests authored by you by:
1. Checking out the branch.
2. Merging the specified reference branch into it.
3. Pushing the updated branch to the remote.

Branches checked out in another git worktree are skipped with a warning (git
can't check them out twice); a skipped branch does not change the exit status.
If a branch fails to check out, merge, or push, the script prints a warning,
continues with the remaining branches, and exits 1 at the end. The branch you
started on is restored on exit.

Arguments:
  <reference_branch>  The branch to merge into your branches (e.g., 'main').

Options:
  --debug     Enable debugging output.
  --all       Update ALL non-protected branches on the remote (not just yours).
              Use with caution - this may update branches owned by others.
  -h, --help  Show this help message and exit.

Examples:
  $SCRIPT_NAME main
  $SCRIPT_NAME --debug main
  $SCRIPT_NAME --all main
  $SCRIPT_NAME --debug --all main
EOF
}

# Parse command-line arguments
REFERENCE_BRANCH=""
# An empty argument leaves REFERENCE_BRANCH empty, so this flag records that a
# positional argument was given. It lets the loop reject a second one, and it
# tells a missing reference branch, which is a usage error, from an empty one,
# which cannot be used.
REFERENCE_BRANCH_GIVEN=false
while [[ $# -gt 0 ]]; do
	case "$1" in
	--debug)
		DEBUG=true
		shift
		;;
	--all)
		ALL_BRANCHES=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	-*)
		echo "Error: Unknown option '$1'" >&2
		usage >&2
		exit 2
		;;
	*)
		if [ "$REFERENCE_BRANCH_GIVEN" = true ]; then
			echo "Error: Multiple reference branches specified: '$REFERENCE_BRANCH' and '$1'" >&2
			usage >&2
			exit 2
		fi
		REFERENCE_BRANCH="$1"
		REFERENCE_BRANCH_GIVEN=true
		shift
		;;
	esac
done

if [ "$REFERENCE_BRANCH_GIVEN" = false ]; then
	echo "Error: Missing <reference_branch> argument." >&2
	echo "Use --help for usage information." >&2
	exit 2
fi

if [ -z "$REFERENCE_BRANCH" ]; then
	echo "Error: The reference branch name is empty." >&2
	exit 1
fi

if [ "$DEBUG" = true ]; then
	set -x
fi

# The repository check below discards git's stderr, so without this probe a
# missing git would be reported as "Not inside a Git repository".
if ! command -v git >/dev/null 2>&1; then
	echo "Error: 'git' is required but not installed." >&2
	echo "Install it from: https://git-scm.com/downloads" >&2
	exit 1
fi

# Ensure we are inside a Git repository
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	echo "Error: Not inside a Git repository." >&2
	exit 1
fi

# Ensure gh CLI is installed
if ! command -v gh >/dev/null 2>&1; then
	echo "Error: 'gh' (GitHub CLI) is required but not installed." >&2
	echo "Install it from: https://cli.github.com/" >&2
	exit 1
fi

# Ensure mergewith, a sibling script from this repository, is on PATH. Without
# this probe, every branch would be checked out and then fail to merge.
if ! command -v mergewith >/dev/null 2>&1; then
	echo "Error: 'mergewith' is required but not installed." >&2
	echo "Install it from: https://github.com/michen00/bin" >&2
	exit 1
fi

# Capture starting ref so we can restore it on exit. If on a branch, capture
# the branch name; if detached, capture the commit SHA so we can re-detach.
if STARTING_REF=$(git symbolic-ref -q --short HEAD); then
	STARTING_DETACHED=false
else
	STARTING_REF=$(git rev-parse HEAD)
	STARTING_DETACHED=true
fi
CURRENT_WORKTREE=$(git rev-parse --show-toplevel)

restore_starting_branch() {
	if [ "$STARTING_DETACHED" = true ]; then
		[ "$(git rev-parse HEAD)" = "$STARTING_REF" ] && return
		git checkout --detach "$STARTING_REF" >/dev/null 2>&1 ||
			echo "Warning: Could not restore the detached HEAD at '$STARTING_REF'. Run 'git checkout --detach $STARTING_REF' to return to it." >&2
	else
		[ "$(git branch --show-current)" = "$STARTING_REF" ] && return
		git checkout "$STARTING_REF" >/dev/null 2>&1 ||
			echo "Warning: Could not restore the starting branch '$STARTING_REF'. Run 'git checkout $STARTING_REF' to return to it." >&2
	fi
}
trap restore_starting_branch EXIT

# Collect branches checked out in OTHER worktrees. Git refuses to check
# those out a second time, so we skip them rather than failing the run.
OTHER_WORKTREE_BRANCHES=$(
	git worktree list --porcelain | awk -v self="$CURRENT_WORKTREE" '
		/^worktree / { wt = substr($0, 10); next }
		/^branch refs\/heads\// {
			if (wt != self) print substr($0, 19)
		}
	'
)

# Fetch latest remote branches to avoid using stale references
if ! git remote update >/dev/null 2>&1; then
	echo "Error: Failed to update the remote-tracking branches. Run 'git remote update' to see why." >&2
	exit 1
fi

# Determine the list of branches to update
if [ "$ALL_BRANCHES" = true ]; then
	echo "Fetching all non-protected branches (use with caution)..."
	if ! BRANCHES=$(gh api repos/:owner/:repo/branches --paginate --jq '.[] | select(.protected == false) | .name' 2>&1); then
		echo "Error: Failed to fetch branches from GitHub API." >&2
		echo "$BRANCHES" >&2
		exit 1
	fi
else
	echo "Fetching branches with open PRs authored by you..."
	if ! BRANCHES=$(gh pr list --author "@me" --state open --json headRefName -q '.[].headRefName' 2>&1); then
		echo "Error: Failed to list PRs. Is 'gh' installed and authenticated?" >&2
		echo "$BRANCHES" >&2
		exit 1
	fi
fi

# Iterate through branches and update them
if [ -z "$BRANCHES" ]; then
	echo "No branches found."
	exit 0
fi

# A failed branch does not stop the loop, so record it for the exit status.
FAILED=false
while read -r BRANCH; do
	# Skip empty lines
	[ -z "$BRANCH" ] && continue

	echo "Processing branch: $BRANCH"

	# Skip branches checked out in another worktree. git refuses to check out
	# such a branch here, and forcing the checkout would change the branch in
	# the worktree that has it checked out.
	if printf '%s\n' "$OTHER_WORKTREE_BRANCHES" | grep -Fxq -- "$BRANCH"; then
		echo "Warning: Skipping branch $BRANCH because it is checked out in another worktree. Update it from that worktree." >&2
		continue
	fi

	# Checkout the branch (create tracking branch if it only exists on remote)
	if ! git checkout "$BRANCH" 2>/dev/null; then
		if ! git switch --track "origin/$BRANCH" 2>/dev/null; then
			echo "Warning: Failed to check out branch $BRANCH. Skipping..." >&2
			FAILED=true
			continue
		fi
	fi

	# Merge the reference branch into the current branch
	if ! mergewith "$REFERENCE_BRANCH"; then
		echo "Warning: Failed to merge $REFERENCE_BRANCH into $BRANCH. Skipping..." >&2
		FAILED=true
		# mergewith can fail before it starts a merge, which leaves nothing to
		# abort, and set -e would then end the run before the next branch.
		git merge --abort >/dev/null 2>&1 || true
		continue
	fi

	# Push the updated branch
	if git push origin "$BRANCH"; then
		echo "Successfully updated and pushed branch: $BRANCH"
	else
		echo "Warning: Failed to push branch $BRANCH. Skipping..." >&2
		FAILED=true
	fi
done <<<"$BRANCHES"

if [ "$FAILED" = true ]; then
	exit 1
fi
